# ============================================================
#  AI 获客系统 配置文件（复制本文件为 .env 后填写）
#  填写后保存，重启服务即生效，无需改任何代码
# ============================================================

# ---- 后台访问（强烈建议修改）----
# 浏览器打开后台需要输入的密码
ACCESS_PASSWORD=请改成你的后台密码

# ---- AI 接口（DeepSeek / OpenAI 等）----
# 接口地址：DeepSeek 用 https://api.deepseek.com/v1
OPENAI_API_BASE=https://api.deepseek.com/v1
# 模型名：DeepSeek 用 deepseek-chat 或 deepseek-reasoner
OPENAI_MODEL=deepseek-chat
# API 密钥（sk- 开头）
OPENAI_API_KEY=在此填写你的AI密钥

# ---- 搜索源（三选一，推荐博查或 SerpAPI）----
# 取值：bing_free(免费Bing) / so_free(免费360) / baidu_free(免费百度) / bocha(博查) / serpapi(SerpAPI)
SEARCH_PROVIDER=bing_free
# SerpAPI 密钥（64位，https://serpapi.com 申请）
SERPAPI_API_KEY=在此填写SerpAPI密钥
# 博查 WebSearch 密钥（https://open.bochaai.com 申请，sk- 开头）
BOCHA_API_KEY=在此填写博查密钥
# 兼容旧版：有些版本把主搜索密钥存在 SEARCH_API_KEY
SEARCH_API_KEY=在此填写主搜索密钥

# ---- 地图渠道（找工程商/集成商，推荐必配）----
# 高德开放平台 Web 服务 Key：https://lbs.amap.com
MAP_API_KEY=在此填写高德密钥
MAP_PROVIDER=amap

# ---- 代理（可选，搜索被限流时启用）----
# 1=启用 0=关闭
PROXY_ENABLED=0
# 单个代理：http://用户名:密码@IP:端口
PROXY_URL=
# 代理池（逗号分隔多个代理）
PROXY_POOL=
# 短效动态代理 API（自动拉取新IP）
PROXY_API_URL=

# ---- 工商查询（可选：企查查 / 天眼查，用于补全联系方式）----
QCC_APP_KEY=
QCC_SECRET_KEY=
TYC_TOKEN=

# ---- 公司信息（展示在页面/邮件里）----
COMPANY_NAME=我的公司名称
INDUSTRY=光纤通信
PRODUCT_NAME=光纤光缆及配套产品

# ---- 邮件触达（可选，用于自动发开发信）----
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASSWORD=

# ---- 监听配置（一般不用改）----
HOST=0.0.0.0
PORT=8017
